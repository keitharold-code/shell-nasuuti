# Supabase project settings — Settings > API in the Supabase dashboard.
# The anon key is safe for client code; NEVER put the service-role key here
# or anywhere in this repo. RLS on every table is what keeps the anon key safe.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
